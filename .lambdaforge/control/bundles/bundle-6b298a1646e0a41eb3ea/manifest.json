{
  "bundle_version": 2,
  "cluster": "local",
  "config": {
    "dataset": {
      "global_assets": {
        "annotation_report": "annotation-report.json",
        "catalog": "catalog.csv",
        "local_manifest": "local-manifest.csv",
        "manifest": "manifest.csv"
      },
      "metadata": {
        "annotation_schema": "1.1",
        "description": "Curated DNA-binding proteins with universal WISDOM surfaces and evaluation sidecars.",
        "structural_schema": "2.1",
        "supervision": "protein-level-only"
      },
      "name": "wisdom-dna",
      "target_schema": {
        "additionalProperties": false,
        "properties": {
          "dna_binding": {
            "enum": [
              0,
              1
            ],
            "type": "integer"
          },
          "local_ground_truth": {
            "type": "boolean"
          }
        },
        "required": [
          "dna_binding",
          "local_ground_truth"
        ],
        "type": "object"
      },
      "version": "1"
    },
    "kind": "dataset",
    "max_parallel": 1,
    "metadata": {
      "framework_contract": "lambdaforge-0.9.1",
      "phase": "complete-dna-preprocessing"
    },
    "output_root": "../runs/datasets",
    "publish": {
      "from": "annotate",
      "index": "members.jsonl",
      "root": "annotations"
    },
    "schema_version": "1.0",
    "stages": {
      "annotate": {
        "bindings": {
          "inputs.base_preprocessing_report": "${nodes.geometry.artifacts.preprocessing-report.json}",
          "inputs.dataset_catalog": "${nodes.curate.artifacts.dataset/catalog.csv}"
        },
        "needs": [
          "curate",
          "geometry"
        ],
        "required": true,
        "reuse": "auto",
        "task": {
          "inputs": {
            "base_preprocessing_report": "../data/dna/public-sources.json",
            "dataset_catalog": "../data/dna/public-sources.json"
          },
          "kind": "task",
          "name": "wisdom-dna-annotate",
          "outputs": {
            "annotation-report": "annotations/annotation-report.json",
            "annotations": "annotations"
          },
          "required_artifacts": [
            "annotations",
            "annotations/annotation-report.json",
            "preprocessing-manifest.json"
          ],
          "rerun_completed": false,
          "resources": {
            "cpus": 36,
            "gpus": 0,
            "memory": "128GiB",
            "time": "24h"
          },
          "resume": true,
          "schema_version": "1.0",
          "task": {
            "params": {
              "checkpoint_interval": 1,
              "on_error": "fail",
              "sink": {
                "params": {
                  "annotation_output": "annotations",
                  "catalog_input": "dataset_catalog",
                  "report_output": "annotation-report"
                },
                "target": "wisdom.dna.DNAAnnotationSink.DNAAnnotationSink"
              },
              "source": {
                "params": {
                  "base_report_input": "base_preprocessing_report",
                  "catalog_input": "dataset_catalog"
                },
                "target": "wisdom.dna.DNAAnnotationSource.DNAAnnotationSource"
              },
              "transforms": [
                {
                  "params": {
                    "negative_gap": 3.0,
                    "positive_gap": 1.4,
                    "sensitivity_gaps": [
                      1.0,
                      1.4,
                      2.0
                    ]
                  },
                  "target": "wisdom.dna.DNAAnnotationTransform.DNAAnnotationTransform"
                }
              ],
              "workers": 1,
              "workload": "cpu"
            },
            "target": "lambdaforge.preprocessing.PreprocessingTask"
          }
        }
      },
      "curate": {
        "required": true,
        "reuse": "auto",
        "task": {
          "inputs": {
            "public_sources": "../data/dna/public-sources.json"
          },
          "kind": "task",
          "name": "wisdom-dna-curate",
          "outputs": {
            "dataset": "dataset",
            "dataset-report": "dataset-report",
            "discovery-cache": "discovery-cache"
          },
          "required_artifacts": [
            "dataset",
            "dataset-report",
            "preprocessing-manifest.json"
          ],
          "rerun_completed": false,
          "resources": {
            "cpus": 36,
            "gpus": 0,
            "memory": "128GiB",
            "time": "24h"
          },
          "resume": true,
          "schema_version": "1.0",
          "task": {
            "params": {
              "checkpoint_interval": 25,
              "on_error": "fail",
              "sink": {
                "params": {
                  "dataset_output": "dataset",
                  "report_output": "dataset-report",
                  "reserve_fraction": 0.1,
                  "seed": 2026,
                  "validation_fraction": 0.2
                },
                "target": "wisdom.dna.DNADatasetSink.DNADatasetSink"
              },
              "source": {
                "params": {
                  "cache_output": "discovery-cache",
                  "max_negative_candidates": 2500,
                  "max_positive_candidates": 0,
                  "mode": "live",
                  "negative_source": "btd-combo-2024",
                  "positive_source": "dyprol-v1",
                  "requests_per_second": 2.0,
                  "retries": 4,
                  "source_manifest_input": "public_sources"
                },
                "target": "wisdom.dna.DNADatasetSource.DNADatasetSource"
              },
              "transforms": [
                {
                  "params": {
                    "cache_output": "discovery-cache",
                    "challenge_aspect_ratio": 4.0,
                    "contact_distance": 4.5,
                    "maximum_resolution": 4.0,
                    "minimum_interface_residues": 2,
                    "minimum_residues": 30,
                    "minimum_sequence_coverage": 0.8,
                    "requests_per_second": 2.0,
                    "retries": 4
                  },
                  "target": "wisdom.dna.DNACandidateCurator.DNACandidateCurator"
                }
              ],
              "workers": 36,
              "workload": "io"
            },
            "target": "lambdaforge.preprocessing.PreprocessingTask"
          }
        }
      },
      "geometry": {
        "bindings": {
          "inputs.protein_identifiers": "${nodes.curate.artifacts.dataset/proteins.txt}"
        },
        "needs": [
          "curate"
        ],
        "required": true,
        "reuse": "auto",
        "task": {
          "inputs": {
            "protein_identifiers": "../data/dna/public-sources.json"
          },
          "kind": "task",
          "name": "wisdom-dna-geometry",
          "outputs": {
            "downloads": "raw",
            "processed": "processed",
            "report": "preprocessing-report.json"
          },
          "required_artifacts": [
            "processed",
            "preprocessing-report.json",
            "preprocessing-manifest.json"
          ],
          "rerun_completed": false,
          "resources": {
            "cpus": 36,
            "gpus": 0,
            "memory": "128GiB",
            "time": "24h"
          },
          "resume": true,
          "schema_version": "1.0",
          "task": {
            "params": {
              "checkpoint_interval": 1,
              "on_error": "skip",
              "sink": {
                "params": {
                  "dataset_output": "processed",
                  "identifier_input": "protein_identifiers",
                  "report_output": "report"
                },
                "target": "preprocess.ProteinSink.ProteinSink"
              },
              "source": {
                "params": {
                  "input_name": "protein_identifiers"
                },
                "target": "preprocess.ProteinSource.ProteinSource"
              },
              "transforms": [
                {
                  "params": {
                    "config": {
                      "params": {
                        "atom_radius": 6.0,
                        "atom_surface_radius": 6.0,
                        "center_coordinates": true,
                        "chains": [],
                        "curvature_scales": [
                          2.5,
                          5.0
                        ],
                        "include_hydrogens": false,
                        "include_metals": false,
                        "include_nonpolymer": false,
                        "include_waters": false,
                        "model_index": 0,
                        "probe_radius": 1.4,
                        "surface_resolution": 1.0
                      },
                      "target": "preprocess.PreprocessConfig.PreprocessConfig"
                    },
                    "download": true,
                    "download_output": "downloads",
                    "identifier_input": "protein_identifiers"
                  },
                  "target": "preprocess.PreprocessPipeline.PreprocessPipeline"
                }
              ],
              "workers": 1,
              "workload": "cpu"
            },
            "target": "lambdaforge.preprocessing.PreprocessingTask"
          }
        }
      }
    }
  },
  "environment": null,
  "lambdaforge_version": "0.9.1",
  "staged": []
}
