{
  "bundle_version": 2,
  "cluster": "citius-ctgpgpu12",
  "config": {
    "execution": {
      "mode": "sequential"
    },
    "extensions": {
      "authoring": {
        "outputs": {
          "dataset": "dataset",
          "dataset-report": "dataset-report",
          "discovery-cache": "discovery-cache"
        }
      }
    },
    "inputs": [
      {
        "name": "public_sources",
        "path": "inputs/0-public-sources.json"
      }
    ],
    "kind": "task",
    "metadata": {
      "phase": "dna-benchmark-curation",
      "warning": "Use max candidate limits for smoke tests; the production build performs public API mapping."
    },
    "name": "wisdom-dna-dataset",
    "output_root": "../runs/tasks",
    "required_artifacts": [
      "dataset",
      "dataset-report",
      "preprocessing-manifest.json",
      "dataset-artifact.json"
    ],
    "rerun_completed": false,
    "resume": true,
    "schema_version": "1.0",
    "task": {
      "params": {
        "checkpoint_interval": 25,
        "dataset_metadata": {
          "grouping": "rcsb-mmseqs2-30-percent-identity",
          "labels": "curated-protein-DNA-binding",
          "local_ground_truth": "evaluation-only",
          "sequence_identity_threshold": 0.3,
          "split_unit": "sequence-cluster"
        },
        "dataset_name": "wisdom-dna-benchmark",
        "dataset_version": "2",
        "on_error": "fail",
        "sink": {
          "params": {
            "dataset_output": "dataset",
            "report_output": "dataset-report",
            "reserve_fraction": 0.1,
            "seed": 2026,
            "validation_fraction": 0.2
          },
          "target": "wisdom.dna.DNADatasetSink.DNADatasetSink"
        },
        "source": {
          "params": {
            "cache_output": "discovery-cache",
            "max_negative_candidates": 2500,
            "max_positive_candidates": 0,
            "mode": "live",
            "negative_source": "btd-combo-2024",
            "positive_source": "dyprol-v1",
            "requests_per_second": 2.0,
            "retries": 4,
            "source_manifest_input": "public_sources"
          },
          "target": "wisdom.dna.DNADatasetSource.DNADatasetSource"
        },
        "transforms": [
          {
            "params": {
              "cache_output": "discovery-cache",
              "challenge_aspect_ratio": 4.0,
              "contact_distance": 4.5,
              "maximum_resolution": 4.0,
              "minimum_interface_residues": 2,
              "minimum_residues": 30,
              "minimum_sequence_coverage": 0.8,
              "requests_per_second": 2.0,
              "retries": 4
            },
            "target": "wisdom.dna.DNACandidateCurator.DNACandidateCurator"
          }
        ],
        "workers": 8,
        "workload": "io"
      },
      "target": "lambdaforge.preprocessing.PreprocessingTask"
    }
  },
  "environment": {
    "dependency_policy": {
      "pytorch": {
        "accelerator": "cuda",
        "architecture": "x86_64",
        "channel": "cu128",
        "compute_capabilities": [
          "9.0"
        ],
        "driver_version": "575.51.03",
        "index_url": "https://download.pytorch.org/whl/cu128",
        "python_version": "3.13",
        "reason": "Selected cu128 for NVIDIA driver 575.51.03 and compute capabilities ('9.0',); the exact wheel exists for the configured remote Python.",
        "require_cuda": true,
        "version": "2.11.0+cu128"
      }
    },
    "environment_id": "env-1ea928a26e322e05bf9e9640",
    "environment_identity_version": 2,
    "offline": false,
    "python_requirement": "==3.13.*",
    "wheels": [
